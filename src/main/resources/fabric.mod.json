{
  "schemaVersion": 1,
  "id": "rocks_infinite_craft",
  "version": "${version}",
  "name": "Rocks' Infinite Craft",
  "license": "MIT",
  "description": "Drop two items together and see what you get. Like Infinite Craft, but in Minecraft.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rocks.infinitecraft.InfiniteCraftMod"
    ],
    "modmenu": [
      "dev.rocks.infinitecraft.client.InfiniteCraftModMenu"
    ],
    "client": [
      "dev.rocks.infinitecraft.client.FusionCrafterModels"
    ],
    "jei_mod_plugin": [
      "dev.rocks.infinitecraft.client.jei.FusionJeiPlugin"
    ]
  },
  "suggests": {
    "cloth-config": ">=26.2.155",
    "modmenu": ">=20.0.1",
    "jei": ">=30.38.0"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "mixins": [
    {
      "config": "infinitecraft.client.mixins.json",
      "environment": "client"
    },
    "infinitecraft.mixins.json"
  ],
  "icon": "assets/rocks_infinite_craft/icon.png"
}
